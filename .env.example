# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=redis

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=paper
DB_PASSWORD=paper
DB_DATABASE=paper

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 (MinIO in development)
S3_HOST=127.0.0.1
S3_PORT=9000
S3_ACCESS_KEY_ID=paper
S3_SECRET_ACCESS_KEY=paperpaper
S3_BUCKET=paper
S3_REGION=us-east-1
