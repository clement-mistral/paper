# Copy to .env.production on the server and fill in the secrets.
# Generate APP_KEY with: openssl rand -base64 32

NODE_ENV=production
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

APP_KEY=
# The Tailscale HTTPS name given by `tailscale serve` (see deploy/README.md).
APP_URL=https://paper.your-tailnet.ts.net

SESSION_DRIVER=redis

DB_HOST=postgres
DB_PORT=5432
DB_USER=paper
DB_PASSWORD=
DB_DATABASE=paper

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Push notifications of the daily review: `node ace push:keys` (see
# deploy/README.md). Empty: notifications disabled.
VAPID_PRIVATE_KEY=
# Contact sent to push services; defaults to APP_URL.
VAPID_SUBJECT=

# Published on the loopback only, for `tailscale serve`.
APP_PORT=3333

# Nightly pg_dump (deploy/backup.sh).
BACKUP_DIR=/srv/paper/backups
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MONTHS=12

# Image built by the CI on each push to `prod` (.github/workflows/release.yml).
# Leave empty to build the image on the server with `--build`.
PAPER_IMAGE=ghcr.io/clement-mistral/paper:latest
